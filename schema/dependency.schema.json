{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.local/cn-k12-kg/dependency.schema.json",
  "title": "先修边",
  "description": "topicId 依赖 prerequisiteId；只保留直接先修，已做传递约简。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topicId",
    "prerequisiteId",
    "strength",
    "reason"
  ],
  "properties": {
    "topicId": {
      "type": "string",
      "pattern": "^m(?:[1-9][ab]|h[1-5])\\.\\d{1,2}\\.\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "prerequisiteId": {
      "type": "string",
      "pattern": "^m(?:[1-9][ab]|h[1-5])\\.\\d{1,2}\\.\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "strength": {
      "type": "string",
      "enum": [
        "hard",
        "soft"
      ],
      "description": "hard：不会前者基本无法学后者；soft：有帮助但非硬门槛"
    },
    "reason": {
      "type": "string",
      "minLength": 6,
      "maxLength": 80
    }
  }
}
