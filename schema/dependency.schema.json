{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cn-k12-kg.local/schema/v1/dependency.schema.json",
  "title": "Prerequisite edge v1",
  "description": "Version 1 authoring contract. JSON Schema is the structural authority; reference and mathematical checks remain separate. Existing records without an optional schema_version are v1; unknown explicit versions are rejected.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "topicId": {
      "type": "string",
      "pattern": "^m(?:[1-9][ab]|h[1-5])\\.\\d{1,2}\\.\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "prerequisiteId": {
      "type": "string",
      "pattern": "^m(?:[1-9][ab]|h[1-5])\\.\\d{1,2}\\.\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "strength": {
      "type": "string",
      "enum": [
        "hard",
        "soft"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "topicId",
    "prerequisiteId",
    "strength",
    "reason"
  ]
}
