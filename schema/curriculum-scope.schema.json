{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cn-k12-kg.local/schema/v1/curriculum-scope.schema.json",
  "title": "Explicit curriculum scope and role requirements",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "subject",
    "scope",
    "roles",
    "topics",
    "units",
    "projects",
    "completion_boundary"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "subject": {
      "const": "mathematics"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "completion_boundary": {
      "type": "string",
      "minLength": 1
    },
    "roles": {
      "type": "object",
      "required": [
        "core",
        "foundation_support",
        "extension"
      ],
      "additionalProperties": false,
      "properties": {
        "core": {
          "$ref": "#/$defs/requirement"
        },
        "foundation_support": {
          "$ref": "#/$defs/requirement"
        },
        "extension": {
          "$ref": "#/$defs/requirement"
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/topic"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "learner_requirement",
        "author_requirement"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "learner_requirement": {
          "type": "string",
          "minLength": 1
        },
        "author_requirement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_id",
        "statement"
      ],
      "properties": {
        "goal_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "criterion_index": {
          "type": "integer",
          "minimum": 0
        },
        "objective_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_id",
        "title",
        "stage",
        "volume",
        "source_tier",
        "role",
        "goals"
      ],
      "properties": {
        "topic_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": [
            "primary",
            "junior",
            "senior"
          ]
        },
        "volume": {
          "type": "string",
          "minLength": 1
        },
        "source_tier": {
          "enum": [
            "core",
            "tool"
          ]
        },
        "role": {
          "enum": [
            "core",
            "foundation_support",
            "extension"
          ]
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/goal"
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "title",
        "stage",
        "role",
        "goals"
      ],
      "properties": {
        "resource_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "enum": [
            "primary",
            "junior",
            "senior"
          ]
        },
        "role": {
          "enum": [
            "core",
            "foundation_support",
            "extension"
          ]
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/goal"
          }
        }
      }
    }
  }
}
