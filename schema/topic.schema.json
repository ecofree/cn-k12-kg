{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cn-k12-kg.local/schema/v1/topic.schema.json",
  "title": "Textbook navigation topic v1",
  "description": "Version 1 authoring contract. JSON Schema is the structural authority; reference and mathematical checks remain separate. Existing records without an optional schema_version are v1; unknown explicit versions are rejected.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^m(?:[1-9][ab]|h[1-5])\\.\\d{1,2}\\.\\d{1,2}(?:\\.\\d{1,2})?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "volume": {
      "type": "string",
      "enum": [
        "一上",
        "一下",
        "二上",
        "二下",
        "三上",
        "三下",
        "四上",
        "四下",
        "五上",
        "五下",
        "六上",
        "六下",
        "七上",
        "七下",
        "八上",
        "八下",
        "九上",
        "九下",
        "必修一",
        "必修二",
        "选必一",
        "选必二",
        "选必三"
      ]
    },
    "chapter": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "section": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "grade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "semester": {
      "type": "string",
      "enum": [
        "上",
        "下",
        "全"
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "数与代数",
        "图形与几何",
        "统计与概率",
        "综合与实践"
      ]
    },
    "theme": {
      "type": "string",
      "enum": [
        "数与式",
        "方程与不等式",
        "函数",
        "图形的性质",
        "图形的变化",
        "图形与坐标",
        "抽样与数据分析",
        "随机事件的概率",
        "综合与实践"
      ]
    },
    "type": {
      "$ref": "https://cn-k12-kg.local/schema/v1/common.schema.json#/$defs/topicType"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "mastery_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(cms-2022:[1-4]\\.(NA|GE|SP|CP)\\.\\d{2}|cms-2017:H\\.(PR|FU|GA|PS|MM)\\.\\d{2})$"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "exact",
              "inferred"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "confidence"
        ]
      },
      "minItems": 0
    },
    "curriculum_version": {
      "type": "string",
      "enum": [
        "2019",
        "2024"
      ]
    },
    "edition": {
      "type": "string",
      "enum": [
        "人教版"
      ]
    },
    "review_status": {
      "$ref": "https://cn-k12-kg.local/schema/v1/common.schema.json#/$defs/reviewStatus"
    },
    "external": {
      "type": "boolean",
      "const": false
    },
    "root_reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "exam_scope": {
      "type": "string",
      "enum": [
        "unknown",
        "included",
        "excluded"
      ]
    },
    "exam_scope_evidence": {
      "$ref": "https://cn-k12-kg.local/schema/v1/common.schema.json#/$defs/examScopeEvidence"
    },
    "exam_scope_note": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "transition_note": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_observation": {
      "type": "string",
      "enum": [
        "found",
        "not_found_in_scanned_sources",
        "source_unavailable",
        "not_checked"
      ]
    },
    "source_observation_evidence": {
      "$ref": "https://cn-k12-kg.local/schema/v1/common.schema.json#/$defs/sourceObservationEvidence"
    }
  },
  "required": [
    "id",
    "name",
    "volume",
    "chapter",
    "section",
    "grade",
    "semester",
    "domain",
    "theme",
    "type",
    "curriculum_version",
    "edition",
    "review_status",
    "external"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "enum": [
              "draft",
              "reviewed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "description",
          "mastery_criteria",
          "standards"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "exam_scope": {
            "enum": [
              "included",
              "excluded"
            ]
          }
        },
        "required": [
          "exam_scope"
        ]
      },
      "then": {
        "required": [
          "exam_scope_evidence"
        ],
        "properties": {
          "exam_scope_evidence": {
            "required": [
              "source_url",
              "scope_reference"
            ],
            "properties": {
              "method": {
                "const": "explicit_scope"
              }
            }
          }
        }
      }
    }
  ]
}
