  "findings": [
    {
      "id": "basis_requires_actual_text",
      "severity": "correctness",
      "before": {
        "reproduction": "basis={independent_review:false,method:[\"not-text\"],limitation:{unexpected:\"object\"}}在policies被接受；basis为null、[]或42触发AttributeError而不是题目级拒绝。",
        "observed_result": "nontext_basis_accepted=True; null/list/integer basis raised AttributeError"
      },
      "fix": {
        "path": "cnkg/admissions.py",
        "behavior": "要求basis是对象，independent_review严格为false，method与limitation均为非空文字；否则抛出ValueError，由check输出带qid的拒绝理由。"
      },
      "after": {
        "test": "test_malformed_review_basis_is_rejected_with_a_question_level_error",
        "cases": 8,
        "result": "全部拒绝；登记文件字节保持不变。"
      }
    },
    {
      "id": "placeholder_family_cannot_be_declared",
      "severity": "correctness",
      "before": {
        "reproduction": "family_id=\"unclassified:outside\"且family_status=\"declared\"时，task_dimensions给known_family=true。",
        "observed_result": "unknown placeholder could satisfy the all-bank known-family dimension"
      },
      "fix": {
        "path": "cnkg/alignment.py",
        "behavior": "已声明状态之外还要求实际非空文字身份，排除unknown、unclassified及unclassified:占位前缀，不修改原任务数据。"
      },
      "after": {
        "test": "test_declared_status_cannot_turn_placeholder_identity_into_known_structure",
        "cases": 7,
        "result": "加强范围外的全部占位/畸形身份均产生known_family门禁错误。"
      }
    }
  ],
