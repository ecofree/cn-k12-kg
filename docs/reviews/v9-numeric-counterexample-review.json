    {
      "id": "e6c48d1ab73dcd5fa1e378833e742530e64c130a4da40bfd597ac2590a6fbeb0",
      "path": "data/teach/mh3.2.3.1.json",
      "pointer": "/why",
      "task_id": null,
      "unchanged_statement": "方程的解集就是直线，联立表示取两个解集的交集。消元若得到一个确定坐标，说明方向不同；若得到矛盾如0=1则无交点，若只余恒等式则两约束等价。因而代数解的个数与几何位置一一对应。",
      "previous_source_sha256": "96705269e5835d17b91295d2e015b86ac71388ed3fe1553a19526ad97fa19cd7",
      "current_source_sha256": "96705269e5835d17b91295d2e015b86ac71388ed3fe1553a19526ad97fa19cd7",
      "unchanged_task_sha256": null,
      "retained_original_decision": "0=1作为消元矛盾的一般例子与恒等式相对，用以区分无解和平面直线无交点；不作为有效数值等式使用。",
      "same_source_bytes": true
    },
    {
