      "decision": "intentional_counterexample",
      "reason": "原文明确使用“误写”标注错误，把加法5+3=8与错误减法5−3=8作对照；正确减法结果应为2。",
      "reviewer_kind": "ai",
      "teacher_review": "pending",
      "path": "data/teach/m1a.2.3.json",
      "pointer": "/pitfalls/0",
      "statement": "把5+3=8误写成5−3=8。"
    },
    {
      "id": "ccb70330219e6c17c4876c38a2c49eecba85be59e0acd75e38d6b62ee323603c",
