      "path": "data/teach/m1a.2.10.json",
      "pointer": "/pitfalls/1",
      "statement": "知道7+3=10却算10−7=7，应数空格所代表的另一部分。"
    },
    {
      "id": "68a477fee613cd90821a353d1fa67464962a451eba5895274a3bd4c9f2802478",
