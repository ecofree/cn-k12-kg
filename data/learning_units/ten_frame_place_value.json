  "coverage_note": "面向小学低年级，集中在20以内的数量、十与一及凑十；不宣称覆盖第一学段全部数与运算。过程题可以先摆小棒、指图或口述，再由学生或陪同者记录解释。",
  "objectives": [
    {
      "id": "ten_frame_place_value:count",
      "statement": "能一一对应点数，并说明只改变摆放、没有添减时个数不变。",
      "granularity": "observable"
    },
    {
      "id": "ten_frame_place_value:compose_ten",
      "statement": "能找出合成10的两个部分，并把需要补入的数量按十的结构拆开。",
      "granularity": "observable"
    },
    {
      "id": "ten_frame_place_value:place_value",
      "statement": "能把1个十与若干个一对应到11至20的数，说明十位上的1表示10个一。",
      "granularity": "observable"
    },
    {
      "id": "ten_frame_place_value:make_ten",
      "statement": "能把20以内进位加法先凑成10再加余数，说明移动的部分不能重复计算。",
      "granularity": "observable"
    },
    {
      "id": "ten_frame_place_value:operation",
      "statement": "能区分合并、拿走与求缺少部分的数量关系，用加减算式或操作核对答案。",
      "granularity": "observable"
    }
  ],
  "explanation": {
    "intuition": "一个十框有两排，每排5格，一共10格。每格放1颗，满框就是1个十。把10根小棒捆成1捆，小棒仍有10根，只是可以把整捆当作一个大单位来数。",
    "reasoning": "先点数，再看十框里还空几格。把8和5合起来时，8还差2到10，从5里拿2补入十框，5剩3，所以8+5=10+3=13。取出来的2已经算进10，不能再加一次。14可以看作1个十和4个一；写成14时左边的1代表10，不是1根。",
    "conditions": [
      "点数时每个物体只点一次，不遗漏，不重复。",
      "一个十框正好10格，每格至多放1颗；小棒一捆明确为10根。",
      "本单元计算结果不超过20，图中不同颜色只帮助看分组，不改变物体个数。",
      "可以先摆、指、说，再记录简短数字或解释；除了结果，还要用操作或语言说明方法。"
    ],
    "counterexample": "把7颗小石子拉得更开，没有添也没有拿走，仍是7颗；一排更长不代表个数更多。又如1捆10根加3根是13根，不能把“1捆”和“3根”直接当同样单位相加成4根。"
  },
  "worked_examples": [
    {
      "prompt": "十框里放了8颗，还空几格？",
      "steps": [
        "每排5格，两排共有10格。",
        "已放8颗，空的两格还可各放1颗。",
        "8和2合起来是10。"
      ],
      "answer": "2",
      "verify": "10-8",
      "family_id": "ten.complete-frame",
      "variant_id": "ten_frame_place_value:example-1"
    },
    {
      "prompt": "1捆10根的小棒，旁边另有4根，一共几根？",
      "steps": [
        "1捆按10根计算。",
        "再加旁边的4根，是14根。",
        "14中的1在十位，表示10；4在个位，表示4。"
      ],
      "answer": "14",
      "verify": "10+4",
      "family_id": "placevalue.ten-and-ones",
      "variant_id": "ten_frame_place_value:example-2"
    },
    {
      "prompt": "摆一摆，说明8+5为什么等于13。",
      "steps": [
        "8到10还差2，把5拆成2和3。",
        "先将2颗移到8颗旁凑满十框，再剩3颗。",
        "总量是10+3=13；移走的2不再留在原来的5里重复计算。"
      ],
      "answer": "13",
      "verify": "8+5",
      "family_id": "addition.make-ten",
      "variant_id": "ten_frame_place_value:example-3"
    }
  ],
