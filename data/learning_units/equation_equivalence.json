      "prompt": "解方程3(x−2)=12，并检验。",
      "steps": [
        "两边同除以非零数3，得到x−2=4。",
        "两边同时加2，得到x=6。",
        "代回原式：3×(6−2)=12，检验成立。"
      ],
      "answer": "6",
      "verify": "12/3+2",
      "family_id": "equation.solve-linear",
      "variant_id": "equation_equivalence:example-1",
      "representation": "symbolic",
      "cognitive_demand": "explain",
      "reference_family_ids": [
        "equation.property-operation-justification"
