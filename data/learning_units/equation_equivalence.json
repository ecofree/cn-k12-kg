  "prerequisites": [
    "能合并同类项，按分配律去括号，并正确计算有理数。",
    "能理解等号两边表示相同的量，用字母表示一个未知数。"
  ],
  "explanation": {
    "intuition": "等式像一架平衡的天平。两边同加同减可以保持平衡；同乘或同除也要检查操作能否逆回去，尤其不能除以0。",
    "reasoning": "解方程的每一步都应保留同一组解。去分母是在两边的每一项上乘同一个非零公倍数；去括号要把符号乘到每一项。求出候选解后代回原方程，实际问题还要检查它是否满足情境限制。",
    "conditions": [
      "同除的数必须非零；若除以含未知数的式子，要先处理它可能为0的情况。",
      "去分母必须作用于两边每一项，包括不带分母的常数。",
      "方程的数学解不一定就是问题允许的解；人数、件数、整小时计费等限制要单独核对。",
      "两边同乘0会把任何方程变成0=0，无法逆回原式，因而通常不保持解集。化简得到0x=0时所有原定义域内的数都满足；得到0x=c且c≠0时无解。"
    ],
    "counterexample": "从0×2=0×3不能两边除以0推出2=3。类似地，解2x=0时不能直接除以可能为0的x，否则会丢掉真正的解x=0。"
  },
  "worked_examples": [
    {
      "prompt": "解方程3(x−2)=12，并检验。",
      "steps": [
        "两边同除以非零数3，得到x−2=4。",
        "两边同时加2，得到x=6。",
        "代回原式：3×(6−2)=12，检验成立。"
      ],
      "answer": "6",
      "verify": "12/3+2",
      "family_id": "equation.solve-linear",
      "variant_id": "equation_equivalence:example-1"
    },
    {
      "prompt": "解方程(x+1)/3−(x−2)/2=1。",
      "steps": [
        "两边每一项同乘6：2(x+1)−3(x−2)=6，右边的1也要乘6。",
        "去括号得2x+2−3x+6=6，合并为−x+8=6。",
        "解得x=2，代回：(2+1)/3−(2−2)/2=1。"
      ],
      "answer": "2",
      "verify": "(2+6-6)/(3-2)",
      "family_id": "equation.solve-linear",
      "variant_id": "equation_equivalence:example-2"
    },
    {
      "prompt": "从0×2=0×3能否同除以0，得到2=3？",
      "steps": [
        "原等式两边都是0，所以成立。",
        "除以0没有定义，不能把这一步当成等式的等价变形。",
        "原等式相等不说明乘0前的两个数相等；丢失的信息不能靠除0恢复。"
      ],
      "answer": "不能；除数为0，操作不合法。",
      "family_id": "equation.divide-variable-zero",
      "variant_id": "equation_equivalence:example-3"
    }
  ],
