  "prerequisites": [
    "能计算角的和与差，并识别互补的两个角。",
    "能使用平行线的内错角相等、同位角相等性质说明角的关系。"
  ],
  "explanation": {
    "intuition": "三根线段围成三角形要真正“拐起来”。若较短两边刚好等于最长边，就只能摊在一条直线上。角的关系也要看位置：一个外角对应的是与它不相邻的两个内角。",
    "reasoning": "对正长度a、b、c，任意两边之和必须大于第三边；已知最大边时，检查其是否小于另外两边之和即可。平面三角形的内角和为180°，可借过顶点作对边平行线，把三个内角转化为一个平角来说明。外角与相邻内角互补，因此外角等于两个不相邻内角之和。",
    "conditions": [
      "讨论的是平面内的非退化三角形，边长为正且单位一致。",
      "三边关系中的大于是严格不等号，等于不能围成非退化三角形。",
      "这里的外角由一边与相邻边的延长线组成；“外角大于内角”只对两个不相邻内角分别成立。",
      "图形比例和测量值可帮助发现关系，但一般结论需要依据条件和定理说明。"
    ],
    "counterexample": "内角为20°、30°、130°的三角形，在130°角处的外角为50°。50°大于两个不相邻内角20°、30°，却小于与它相邻的130°内角，所以不能删掉“不相邻”这个条件。"
  },
  "worked_examples": [
    {
      "prompt": "长度为4cm、5cm、7cm的三条线段能围成三角形吗？若把7cm改成9cm呢？",
      "steps": [
        "最长边为7cm，只需核对4+5>7，成立；另外两组不等式因长度为正也成立。",
        "所以4cm、5cm、7cm可以围成三角形。",
        "改成9cm后4+5=9，不满足严格大于；三段拉直，不能围成非退化三角形。"
      ],
      "answer": "4、5、7可以；4、5、9不可以。",
      "family_id": "triangle.side-feasibility",
      "variant_id": "triangle_conditions:example-1"
    },
    {
      "prompt": "三角形ABC中，∠A=40°，∠B=75°。延长BC到D，求∠ACD。",
      "steps": [
        "内角和给出∠ACB=180°−40°−75°=65°。",
        "BC与CD在一条直线上，∠ACD=180°−65°=115°。",
        "也可直接用外角定理：∠ACD=∠A+∠B=115°；相邻的∠ACB不在这个和里。"
      ],
      "answer": "115",
      "verify": "40+75",
      "family_id": "triangle.exterior-angle-sum",
      "variant_id": "triangle_conditions:example-2"
    },
    {
      "prompt": "三角形内角为20°、30°、130°。130°处的邻补外角是否比所有内角都大？",
      "steps": [
        "该外角为180°−130°=50°。",
        "50°大于两个不相邻内角20°和30°，但小于相邻内角130°。",
        "这反驳了删去“不相邻”限制的说法；正确关系保留两个不相邻内角。"
      ],
      "answer": "不是；50°小于相邻内角130°。",
      "family_id": "triangle.exterior-universal-counterexample",
      "variant_id": "triangle_conditions:example-3"
    },
    {
      "prompt": "怎样利用过A且平行于BC的直线说明三角形内角和？",
      "steps": [
        "过A作直线DE∥BC。",
        "由平行线的内错角关系，∠DAB=∠ABC，∠CAE=∠ACB。",
        "∠DAB、∠BAC、∠CAE依次拼成平角，因此三个内角之和180°。"
      ],
      "answer": "平行线把两个底角移到A旁，与顶角拼成180°。",
      "family_id": "triangle.angle-sum-proof",
      "variant_id": "triangle_conditions:example-4"
    }
  ],
