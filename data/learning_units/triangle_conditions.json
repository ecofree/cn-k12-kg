    },
    {
      "id": "triangle_conditions:o3",
      "statement": "能用已知条件和定理组织可检查的说理，区分测量例子、反例与一般证明。",
      "granularity": "composite"
    },
    {
      "id": "triangle_conditions:feasibility",
