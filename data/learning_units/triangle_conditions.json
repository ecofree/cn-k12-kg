  "objectives": [
    {
      "id": "triangle_conditions:o1",
      "statement": "能用严格的三角形三边关系判断正长度能否围成三角形，并处理等号和整数范围。",
      "granularity": "composite"
    },
    {
      "id": "triangle_conditions:o2",
