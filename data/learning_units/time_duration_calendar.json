      "refines_objective_ids": [
        "time_duration_calendar:o1"
      ]
    },
    {
      "id": "time_duration_calendar:units60",
      "statement": "能以1小时等于60分钟换算复合时长，区分时分记法与十进制小数。",
      "granularity": "observable",
      "refines_objective_ids": [
        "time_duration_calendar:o2"
      ]
    },
    {
      "id": "time_duration_calendar:elapsed",
      "statement": "能根据完整日期时刻求经过时间或反求起止时刻，并检查跨日条件。",
