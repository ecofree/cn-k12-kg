      "refines_objective_ids": [
        "time_duration_calendar:o2"
      ]
    },
    {
      "id": "time_duration_calendar:calendar",
      "statement": "能按给定公历月份与闰年规则判断跨月经过的天数。",
      "granularity": "observable",
      "refines_objective_ids": [
        "time_duration_calendar:o3"
      ]
    },
    {
      "id": "time_duration_calendar:count_intervals",
      "statement": "能区分日期或时刻的个数与它们之间的间隔数，并说明是否包含首尾。",
      "granularity": "observable",
      "refines_objective_ids": [
        "time_duration_calendar:o1",
        "time_duration_calendar:o3"
      ]
    }
  ],
  "prerequisites": [
    "能读写100以内的数，进行简单加减法。",
    "知道一天有上午、下午和夜间，能按顺序说出12个月。"
  ],
  "explanation": {
    "intuition": "时刻是时间线上的一个点，例如8:20；经过时间是两个点之间的一段，例如20分钟。钟面上的分针走一大格是5分钟，走一圈是60分钟；小时不是满100分进1。",
    "reasoning": "钟面先看分针，再看时针位于哪两个数之间；8:20时分针在4，时针已离开8向9移动。计算经过时间，可以沿时间线分段相加，也可以把同一天的时刻换成从0:00起累计的分钟数再相减。跨日必须加入完整的一天。跨月先核对各月天数与年份，再数两个日期之间实际经过的整天数。",
    "conditions": [
      "1小时=60分钟，1分钟=60秒；本单元的日期与钟表计算采用题设中的同一时区与普通24小时日，不涉及夏令时等校时问题。",
      "24时计时法中，下午1时记13:00；当天结束的24:00与次日开始的00:00是同一时刻，必须连同日期解释。",
      "公历1、3、5、7、8、10、12月有31天，4、6、9、11月有30天；2月平年28天、闰年29天。",
      "题目采用公历规则：年份能被4整除且不能被100整除，或能被400整除，为闰年；整百年份规则作为本单元给定条件使用。",
      "计算两个同一钟点日期之间“经过多少天”时数间隔；若问活动“包含首尾日期共几天”，应另计日期个数，不能混用。"
    ],
    "counterexample": "9:50到10:10经过20分钟，不能把时刻当成小数，用10.10−9.50=0.60就说经过60分钟。分钟满60进1小时，且小数0.60小时实际是36分钟。"
  },
  "worked_examples": [
    {
      "prompt": "同一天上午8:45开始阅读，9:20结束。经过多少分钟？",
      "steps": [
        "从8:45到9:00经过15分钟。",
        "从9:00到9:20再经过20分钟。",
        "总共15+20=35分钟；也可算(9×60+20)−(8×60+45)。"
      ],
      "answer": "35",
      "verify": "(9*60+20)-(8*60+45)",
      "family_id": "time.elapsed-sameday",
      "variant_id": "time_duration_calendar:example-1"
    },
    {
      "prompt": "一班车5月6日23:40出发，5月7日00:25到达，途中没有调时。经过多少分钟？",
      "steps": [
        "5月6日23:40到当日24:00经过20分钟。",
        "当日24:00就是5月7日00:00，再到00:25经过25分钟。",
        "总时长为45分钟；不能只用00:25减23:40而忽略日期。"
      ],
      "answer": "45",
      "verify": "(24*60-(23*60+40))+25",
      "family_id": "time.elapsed-cross-midnight",
      "variant_id": "time_duration_calendar:example-2"
    },
    {
      "prompt": "从公历2028年2月28日中午12:00到3月1日中午12:00，经过几天？",
      "steps": [
        "2028可被4整除且不是整百年份，是闰年，2月有29天。",
        "从2月28日中午到2月29日中午是1整天，再到3月1日中午又是1整天。",
        "共经过2整天。"
      ],
      "answer": "2天",
      "family_id": "time.calendar-ordinary-leap",
      "variant_id": "time_duration_calendar:example-3"
    },
    {
      "prompt": "时间线上依次标出2月28日中午、2月29日中午、3月1日中午，为什么3个日期标记只对应2个整天间隔？",
      "steps": [
        "相邻两个中午之间是1个整天间隔。",
        "从第1个标记到第2个、第2个到第3个，共2段。",
        "若数包含首尾的日期名称则是3个，计数对象和经过时间不同。"
      ],
      "answer": "3个时刻标记之间只有2段间隔。",
      "family_id": "time.date-points-vs-intervals",
      "variant_id": "time_duration_calendar:example-4"
    }
  ],
