  "objectives": [
    {
      "id": "time_duration_calendar:o1",
      "statement": "能读取钟面和24时计时法中的时刻，区分一个时刻与一段经过时间。",
      "granularity": "composite"
    },
    {
      "id": "time_duration_calendar:o2",
      "statement": "能把时、分换成同一单位，计算同日或已明确跨日的经过时间，并检查60进制换算。",
      "granularity": "composite"
    },
    {
      "id": "time_duration_calendar:o3",
      "statement": "能利用给定的公历月份天数和闰年规则计算简单跨月间隔，说明日期包含方式。",
      "granularity": "composite"
    },
    {
      "id": "time_duration_calendar:read_time",
      "statement": "能把钟面、上午下午与24时记法对应，并把时刻作为时间线上的点。",
