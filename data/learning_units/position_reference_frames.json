  "prerequisites": [
    "能辨认东、南、西、北，知道相邻方向夹角为90°。",
    "能读取整数刻度和角的度数，理解图中一个方格对应的实际长度。"
  ],
  "explanation": {
    "intuition": "“在右边”必须知道是谁朝哪个方向看；“北偏东30°”必须知道从哪个地点出发、从北向转向东多大角度。数对也有约定：先列后行，交换顺序通常就换了位置。",
    "reasoning": "先选参照点，再确定方向基准。以北为基准朝东转30°，同一条射线也可说东偏北60°，因为北与东相差90°。从终点返回起点时方向反转180°，北偏东30°变为南偏西30°，距离不变。在方格图中，先数列再数行；沿折线路线走过的各段相加得到路程，不能直接当作起终点间的直线距离。",
    "conditions": [
      "所有方向描述都要给参照点；“左、右”还需给观察者的朝向。",
      "本单元地图以所标北向为准；本图的北向朝上，不把“页面上方就是北方”当作所有地图的固定规则。",
      "北偏东θ°与东偏北(90−θ)°表示同一方向；角在0°与90°之间时使用这里的偏角表达。",
      "本单元数对约定先列后行：列从左向右编号，行从下向上编号，均从1开始；换约定需重新说明。",
      "方格路径只沿给定的横竖网格线；实际比例尺用于各段路程的换算，折线路程与直线距离是不同量。"
    ],
    "counterexample": "面朝北时右手侧是东，转身面朝南时右手侧变为西，所以“永远在右边”不能代替“在东边”。又如学校北偏东30°的方向不能写成东偏北30°；后者与原方向相差30°。"
  },
  "worked_examples": [
    {
      "prompt": "公园P在学校O的北偏东30°方向600米处。从P看O是什么方向和距离？",
      "steps": [
        "先把参照点从O换到P，观察同一条连线的反方向。",
        "原来向北、向东的分量反向成为向南、向西。",
        "因此O在P的南偏西30°方向，距离仍为600米。"
      ],
      "answer": "O在P的南偏西30°方向600米处。",
      "family_id": "position.reverse-bearing",
      "variant_id": "position_reference_frames:example-1",
      "representation": "geometry",
      "cognitive_demand": "explain"
    },
    {
      "prompt": "方格图按先列后行编号，每格边长表示100米。A在(2,1)，B在(5,3)。从A沿网格先向东再向北走到B，路线怎样描述？走了多少米？",
      "steps": [
        "列号从2到5，向东走3格；行号从1到3，向北走2格。",
        "共走3+2=5格，每格100米，路程500米。",
        "500米描述这条折线路线，不是A到B的直线距离；换走法可能改变路程。"
      ],
      "answer": "先向东300米，再向北200米；路程500米。",
      "family_id": "position.route-length-versus-distance",
      "variant_id": "position_reference_frames:example-2",
      "representation": "symbolic",
      "cognitive_demand": "explain",
      "reference_family_ids": [
