{
  "volume": "六上",
  "topics": {
    "m6a.1.1": {
      "description": "用数对可以确定平面上点的位置，数对写作（列，行），先写列数再写行数；列与行的顺序不能互换。",
      "mastery_criteria": ["能用数对表示点的位置", "能根据数对在方格纸上找到点"],
      "type": "conceptual",
      "standards": [{"id": "cms-2022:2.GE.03", "confidence": "exact"}]
    },
    "m6a.2.1": {
      "description": "分数乘整数，用分子乘整数的积作分子、分母不变；分数乘分数，分子相乘作分子、分母相乘作分母，能约分先约分。",
      "mastery_criteria": ["能计算分数乘整数与分数乘分数", "能在计算前先约分简化"],
      "type": "procedural",
      "standards": [{"id": "cms-2022:2.NA.02", "confidence": "exact"}]
    },
    "m6a.3.1": {
      "description": "除以一个不为 0 的数，等于乘这个数的倒数；求一个数的倒数，把分子分母交换位置（整数看作分母为 1）。",
      "mastery_criteria": ["能求一个数的倒数", "能把分数除法转化为乘法计算"],
      "type": "procedural",
      "standards": [{"id": "cms-2022:2.NA.02", "confidence": "exact"}]
    },
    "m6a.4.1": {
      "description": "圆的认识：圆心决定位置、半径决定大小，同圆内直径是半径的 2 倍；圆的周长 C=πd=2πr，面积 S=πr²。",
      "mastery_criteria": ["能说出半径与直径的关系", "能计算圆的周长与面积"],
      "type": "procedural",
      "standards": [{"id": "cms-2022:2.GE.02", "confidence": "exact"}]
    },
    "m6a.5.1": {
      "description": "表示一个数是另一个数的百分之几的数叫百分数，也叫百分率；百分数化成小数要去掉百分号并把小数点左移两位。",
      "mastery_criteria": ["理解百分数表示两个数的倍比关系", "能进行百分数与小数的互化"],
      "type": "conceptual",
      "standards": [{"id": "cms-2022:2.NA.01", "confidence": "exact"}]
    }
  },
  "dependencies": [
    {"topicId": "m6a.1.1", "prerequisiteId": "m5a.4.1", "strength": "soft", "reason": "用数对确定位置要与方格纸上的图形运动经验结合。"},
    {"topicId": "m6a.2.1", "prerequisiteId": "m3a.6.5", "strength": "hard", "reason": "分数乘法建立在同分母分数加减与分数意义之上。"},
    {"topicId": "m6a.3.1", "prerequisiteId": "m6a.2.1", "strength": "hard", "reason": "分数除法要用乘倒数，依赖分数乘法的熟练。"},
    {"topicId": "m6a.4.1", "prerequisiteId": "m3b.3.1", "strength": "hard", "reason": "圆是多边形之外的特殊平面图形，先掌握多边形的基本概念。"},
    {"topicId": "m6a.5.1", "prerequisiteId": "m3b.6.1", "strength": "hard", "reason": "百分数与小数同属十进制的表达方式。"}
  ],
  "questions": [
    {"id": "m6a.1.1-q1", "topicId": "m6a.1.1", "difficulty": "basic", "type": "choice", "prompt": "用数对 (3,5) 表示位置，其中的 3 表示什么？", "choices": [{"key": "A", "text": "第 3 列"}, {"key": "B", "text": "第 3 行"}, {"key": "C", "text": "第 3 层"}], "answer": "A", "explanation": "数对先写列数、再写行数，3 表示第 3 列。"},
    {"id": "m6a.1.1-q2", "topicId": "m6a.1.1", "difficulty": "basic", "type": "choice", "prompt": "数对 (4,2) 和 (2,4) 表示的位置相同吗？", "choices": [{"key": "A", "text": "相同"}, {"key": "B", "text": "不同"}], "answer": "B", "explanation": "数对是有序的，列与行交换后位置不同。"},
    {"id": "m6a.2.1-q1", "topicId": "m6a.2.1", "difficulty": "basic", "type": "numeric", "prompt": "1/2×4=？（只填数字）", "answer": "2", "verify": "1/2*4", "explanation": "分子 1×4=4，分母不变，4/2=2。"},
    {"id": "m6a.2.1-q2", "topicId": "m6a.2.1", "difficulty": "basic", "type": "numeric", "prompt": "2/3×3/4=？（只填小数）", "answer": "0.5", "verify": "(2/3)*(3/4)", "explanation": "分子分母分别相乘得 6/12，约分为 1/2，即 0.5。"},
    {"id": "m6a.3.1-q1", "topicId": "m6a.3.1", "difficulty": "basic", "type": "numeric", "prompt": "1/2÷1/4=？（只填数字）", "answer": "2", "verify": "(1/2)/(1/4)", "explanation": "除以 1/4 等于乘 4，1/2×4=2。"},
    {"id": "m6a.3.1-q2", "topicId": "m6a.3.1", "difficulty": "basic", "type": "numeric", "prompt": "3/4÷3=？（只填小数）", "answer": "0.25", "verify": "(3/4)/3", "explanation": "除以 3 等于乘 1/3，得 1/4，即 0.25。"},
    {"id": "m6a.4.1-q1", "topicId": "m6a.4.1", "difficulty": "basic", "type": "numeric", "prompt": "半径为 3 厘米的圆，直径是多少厘米？（只填数字）", "answer": "6", "verify": "3*2", "explanation": "直径是半径的 2 倍，3×2=6 厘米。"},
    {"id": "m6a.4.1-q2", "topicId": "m6a.4.1", "difficulty": "basic", "type": "numeric", "prompt": "半径为 2 厘米的圆，周长是多少厘米？（π 取 3.14，只填数字）", "answer": "12.56", "verify": "2*3.14*2", "explanation": "C=2πr=2×3.14×2=12.56 厘米。"},
    {"id": "m6a.5.1-q1", "topicId": "m6a.5.1", "difficulty": "basic", "type": "numeric", "prompt": "0.75 化成百分数是多少？（只填数字，不带百分号）", "answer": "75", "verify": "0.75*100", "explanation": "小数化百分数，小数点右移两位并加百分号，得 75%。"},
    {"id": "m6a.5.1-q2", "topicId": "m6a.5.1", "difficulty": "basic", "type": "numeric", "prompt": "50% 化成小数是多少？（只填小数）", "answer": "0.5", "verify": "50/100", "explanation": "百分数化小数，去掉百分号并把小数点左移两位，得 0.5。"}
  ]
}
