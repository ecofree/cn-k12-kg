{
  "volume": "五上",
  "topics": {
    "m5a.1.1": {
      "description": "观察由几个小正方体搭成的组合体，从正面、左面、上面看到的形状可能不同；判断时要想象视线正对观察方向。",
      "mastery_criteria": ["能画出组合体从不同方向看到的形状", "能由视图判断小正方体的摆法"],
      "type": "reasoning",
      "standards": [{"id": "cms-2022:2.GE.01", "confidence": "exact"}]
    },
    "m5a.2.1": {
      "description": "小数乘法先按整数乘法算出积，再看两个因数一共有几位小数，就从积的右边起数出几位点上小数点。",
      "mastery_criteria": ["能按整数乘法算小数乘法并正确点小数点", "能处理积的小数位数不够时补 0"],
      "type": "procedural",
      "standards": [{"id": "cms-2022:2.NA.02", "confidence": "exact"}]
    },
    "m5a.3.1": {
      "description": "除数是整数的小数除法按整数除法算，商的小数点与被除数的小数点对齐；除数是小数的除法先把它转化成除数是整数再算。",
      "mastery_criteria": ["能计算除数是整数的小数除法", "能把除数是小数的除法转化为整数除法"],
      "type": "procedural",
      "standards": [{"id": "cms-2022:2.NA.02", "confidence": "exact"}]
    },
    "m5a.4.1": {
      "description": "平移只改变图形的位置，旋转是绕定点转动，轴对称图形对折后两部分重合；三种变换都不改变图形的形状和大小。",
      "mastery_criteria": ["能判断图形经过的是哪种变换", "能在方格纸上画出变换后的图形"],
      "type": "conceptual",
      "standards": [{"id": "cms-2022:2.GE.03", "confidence": "exact"}]
    },
    "m5a.5.1": {
      "description": "用字母可以表示数和数量关系，如 a×b 可以写成 ab；含有字母的式子既能表示结果，也能表示关系。",
      "mastery_criteria": ["能用含字母的式子表示数量关系", "能把字母式子的简写形式写正确"],
      "type": "conceptual",
      "standards": [{"id": "cms-2022:2.NA.03", "confidence": "exact"}]
    },
    "m5a.6.1": {
      "description": "平行四边形面积=底×高，三角形面积=底×高÷2，梯形面积=(上底+下底)×高÷2；公式都由转化为长方形推导而来。",
      "mastery_criteria": ["能计算平行四边形、三角形、梯形的面积", "能说清公式推导中的转化思路"],
      "type": "procedural",
      "standards": [{"id": "cms-2022:2.GE.02", "confidence": "exact"}]
    },
    "m5a.7.1": {
      "description": "事件发生有确定与不确定之分：一定发生、不可能发生是确定的，可能发生也可能不发生是不确定的；可能性有大小。",
      "mastery_criteria": ["能判断事件是确定还是不确定的", "能比较不同事件发生的可能性大小"],
      "type": "conceptual",
      "standards": [{"id": "cms-2022:2.SP.01", "confidence": "inferred"}]
    }
  },
  "dependencies": [
    {"topicId": "m5a.1.1", "prerequisiteId": "m3a.1.2", "strength": "hard", "reason": "组合体观察是在单一立体图形观察基础上的扩展。"},
    {"topicId": "m5a.2.1", "prerequisiteId": "m3b.6.3", "strength": "hard", "reason": "小数乘法建立在小数意义与加减法之上。"},
    {"topicId": "m5a.3.1", "prerequisiteId": "m5a.2.1", "strength": "hard", "reason": "除法是乘法的逆运算，先掌握小数乘法。"},
    {"topicId": "m5a.4.1", "prerequisiteId": "m3b.1.1", "strength": "hard", "reason": "图形的运动建立在认识平移旋转现象之上。"},
    {"topicId": "m5a.5.1", "prerequisiteId": "m2b.4.3", "strength": "hard", "reason": "用字母表示数量关系要先理解加减乘除各部分的关系。"},
    {"topicId": "m5a.5.1", "prerequisiteId": "m3a.2.1", "strength": "soft", "reason": "字母式子要按运算顺序书写。"},
    {"topicId": "m5a.6.1", "prerequisiteId": "m3b.4.2", "strength": "hard", "reason": "多边形面积公式由长方形面积公式推导而来。"},
    {"topicId": "m5a.7.1", "prerequisiteId": "m3b.5.1", "strength": "soft", "reason": "可能性以对数据的收集与整理经验为基础。"}
  ],
  "questions": [
    {"id": "m5a.1.1-q1", "topicId": "m5a.1.1", "difficulty": "basic", "type": "choice", "prompt": "从上面看一个竖放的圆柱，看到的是什么图形？", "choices": [{"key": "A", "text": "圆"}, {"key": "B", "text": "长方形"}, {"key": "C", "text": "三角形"}], "answer": "A", "explanation": "圆柱的上下底面是圆，从上面看是圆。"},
    {"id": "m5a.1.1-q2", "topicId": "m5a.1.1", "difficulty": "basic", "type": "choice", "prompt": "3 个同样的小正方体排成一排，从正面看到的是什么？", "choices": [{"key": "A", "text": "3 个正方形横着排"}, {"key": "B", "text": "1 个正方形"}, {"key": "C", "text": "1 个三角形"}], "answer": "A", "explanation": "3 个正方体横排，正面看到 3 个正方形排成一行。"},
    {"id": "m5a.2.1-q1", "topicId": "m5a.2.1", "difficulty": "basic", "type": "numeric", "prompt": "0.5×4=？（只填数字）", "answer": "2", "verify": "0.5*4", "explanation": "5×4=20，因数共 1 位小数，积为 2.0，即 2。"},
    {"id": "m5a.2.1-q2", "topicId": "m5a.2.1", "difficulty": "basic", "type": "numeric", "prompt": "1.2×3=？（只填小数）", "answer": "3.6", "verify": "1.2*3", "explanation": "12×3=36，因数有 1 位小数，积为 3.6。"},
    {"id": "m5a.3.1-q1", "topicId": "m5a.3.1", "difficulty": "basic", "type": "numeric", "prompt": "4.8÷4=？（只填小数）", "answer": "1.2", "verify": "4.8/4", "explanation": "48÷4=12，商的小数点与被除数对齐，得 1.2。"},
    {"id": "m5a.3.1-q2", "topicId": "m5a.3.1", "difficulty": "basic", "type": "numeric", "prompt": "7.5÷2.5=？（只填数字）", "answer": "3", "verify": "7.5/2.5", "explanation": "同时扩大 10 倍变为 75÷25=3。"},
    {"id": "m5a.4.1-q1", "topicId": "m5a.4.1", "difficulty": "basic", "type": "choice", "prompt": "把一个图形向右平移 3 格，图形的形状和大小会怎样？", "choices": [{"key": "A", "text": "改变"}, {"key": "B", "text": "不变"}, {"key": "C", "text": "变大"}], "answer": "B", "explanation": "平移只改变位置，形状和大小都不变。"},
    {"id": "m5a.4.1-q2", "topicId": "m5a.4.1", "difficulty": "basic", "type": "choice", "prompt": "长方形有几条对称轴？", "choices": [{"key": "A", "text": "2 条"}, {"key": "B", "text": "4 条"}, {"key": "C", "text": "1 条"}], "answer": "A", "explanation": "长方形有两条对称轴，分别是两组对边中点的连线。"},
    {"id": "m5a.5.1-q1", "topicId": "m5a.5.1", "difficulty": "basic", "type": "choice", "prompt": "用 a 表示单价、x 表示数量，总价可以写成什么？", "choices": [{"key": "A", "text": "a+x"}, {"key": "B", "text": "a×x"}, {"key": "C", "text": "a÷x"}], "answer": "B", "explanation": "总价=单价×数量，即 a×x。"},
    {"id": "m5a.5.1-q2", "topicId": "m5a.5.1", "difficulty": "basic", "type": "numeric", "prompt": "当 a=4、b=3 时，2a+b 的值是多少？（只填数字）", "answer": "11", "verify": "2*4+3", "explanation": "2×4+3=11。"},
    {"id": "m5a.6.1-q1", "topicId": "m5a.6.1", "difficulty": "basic", "type": "numeric", "prompt": "平行四边形底 6 厘米、高 4 厘米，面积是多少平方厘米？（只填数字）", "answer": "24", "verify": "6*4", "explanation": "平行四边形面积=底×高=24 平方厘米。"},
    {"id": "m5a.6.1-q2", "topicId": "m5a.6.1", "difficulty": "basic", "type": "numeric", "prompt": "三角形底 6 厘米、高 4 厘米，面积是多少平方厘米？（只填数字）", "answer": "12", "verify": "6*4/2", "explanation": "三角形面积=底×高÷2=12 平方厘米。"},
    {"id": "m5a.7.1-q1", "topicId": "m5a.7.1", "difficulty": "basic", "type": "choice", "prompt": "盒子里全是红球，摸出一个球，结果是什么？", "choices": [{"key": "A", "text": "一定是红球"}, {"key": "B", "text": "可能是红球"}, {"key": "C", "text": "不可能是红球"}], "answer": "A", "explanation": "盒中只有红球，摸出的一定是红球，这是确定事件。"},
    {"id": "m5a.7.1-q2", "topicId": "m5a.7.1", "difficulty": "basic", "type": "choice", "prompt": "盒子里有 3 个红球和 1 个白球，摸到哪种球的可能性大？", "choices": [{"key": "A", "text": "红球"}, {"key": "B", "text": "白球"}, {"key": "C", "text": "一样大"}], "answer": "A", "explanation": "红球数量多，摸到的可能性更大。"}
  ]
}
